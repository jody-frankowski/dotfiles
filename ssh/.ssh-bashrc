# -*- mode: sh; comment-start: "# " -*- vim: set ft=sh commentstring=#\ %s :

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc

_onlinux () {
  [[ "$OSTYPE" == linux-gnu ]]
}
_onmac () {
  [[ "$OSTYPE" == darwin* ]]
}

_onmac && export BASH_SILENCE_DEPRECATION_WARNING=1

### Bash Settings ###
## Keybindings ##
# Make Alt-bs stop at whitespaces and `/` making it identical to our Zsh config
bind '"\e\C-?": unix-filename-rubout'
bind '"\e\C-h": unix-filename-rubout'
## Keybindings ##

## Completion ##
# Insensitive completion
bind 'set completion-ignore-case on'
# Activate if possible
if [[ -f /usr/share/bash-completion/bash_completion ]]; then
  . /usr/share/bash-completion/bash_completion
elif [[ -f /etc/bash_completion ]]; then
  . /etc/bash_completion
fi
## Completion ##

# ignore commands starting with spaces and duplicates
HISTCONTROL=ignoreboth
# show human readable time
HISTTIMEFORMAT="%c "

# check the window size after each command and, if necessary, updates the values of LINES and COLUMNS.
shopt -s checkwinsize
# TODO needed???
#shopt -s histappend

### Aliases ###
## Global aliases ##
if ! $0 --version | grep -q 'version 3.2'; then
  _magic_space() {
      local pre=${READLINE_LINE:0:READLINE_POINT}
      local post=${READLINE_LINE:READLINE_POINT}
      [[ $pre == *' H' ]] && pre="${pre%' H'} | head"
      [[ $pre == *' HD' ]] && pre="${pre%' HD'} | hexdump -C"
      [[ $pre == *' G' ]] && pre="${pre%' G'} | grep"
      [[ $pre == *' GV' ]] && pre="${pre%' GV'} | grep -v"
      [[ $pre == *' L' ]] && pre="${pre%' L'} | less"
      [[ $pre == *' S' ]] && pre="${pre%' S'} | sort"
      [[ $pre == *' SU' ]] && pre="${pre%' SU'} | sort -u"
      [[ $pre == *' T' ]] && pre="${pre%' T'} | tail"
      [[ $pre == *' U' ]] && pre="${pre%' U'} | uniq"

      [[ $pre == *' X' ]]  && pre="${pre%' X'}  | xargs -r"
      [[ $pre == *' XI' ]] && pre="${pre%' XI'} | xargs -r -I{}"
      [[ $pre == *' XIN' ]] && pre="${pre%' XIN'} | xargs -r -I{} -n"
      [[ $pre == *' XN' ]] && pre="${pre%' XN'} | xargs -r -n"

      [[ $pre == *' NE' ]]  && pre="${pre%' NE'}  2>/dev/null"
      [[ $pre == *' NEO' ]] && pre="${pre%' NEO'} &>/dev/null"
      [[ $pre == *' NO' ]]  && pre="${pre%' NO'}  >/dev/null"

      [[ $pre == *' JQ' ]] && pre="${pre%' JQ'} | jq"

      [[ $pre == *' OJ' ]] && pre="${pre%' OJ'} -o json"
      [[ $pre == *' OY' ]] && pre="${pre%' OY'} -o yaml"

      [[ $pre == *' WCC' ]] && pre="${pre%' WCC'} | wc -c"
      [[ $pre == *' WCL' ]] && pre="${pre%' WCL'} | wc -l"
      pre+=' '
      READLINE_LINE=$pre$post
      READLINE_POINT=${#pre}
  }
  bind -x '" ": _magic_space'
fi
## Global aliases ##

alias ..='cd ..'
alias ...='cd ../..'

alias cgrep="grep -Ev '^\s*[#$;]|^$'"
alias grep='grep --color=auto -i'
alias g='grep -r'

alias ls='ls --color=auto'
_onlinux && alias ls='ls --color=auto --group-directories-first'
alias l='ls -lh'
alias la='l -A'
alias lat='la -t'
alias latr='lat -r'

# Misc
export LESS='-i -M -R -j4'
command -v zless    >/dev/null && alias less=zless
command -v zstdless >/dev/null && alias less=zstdless

alias cpv='rsync -avP'
alias cpvr='rsync -avP --inplace --size-only -i'
alias cpvs='rsync -avP --rsync-path="sudo rsync"'

alias meminfo='free -m -l -t'
alias pscpu='ps auxf | sort -n -k 3'
alias psg="ps aux | grep"
alias psmem='ps auxf | sort -n -k 4'

alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gst='git status'

# Safer commands
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm --one-file-system -I'

# Sudo commands
alias s=sudo
alias dmesg='sudo dmesg'
alias doc='sudo docker'
# Since our tmux config (`set -g set-titles-string "#{host_short} #{pane_title}"`) already preprends
# the hostname to the window title, we set the TMUX var to bash sessions inside tmux skip adding themselves the hostname
alias ssu='sudo TMUX=$TMUX bash --rcfile /tmp/$(whoami)-bashrc'

# Systemd
alias jc='sudo journalctl'
alias sc='sudo systemctl'
_completion_loader journalctl 2>/dev/null
_completion_loader systemctl  2>/dev/null
complete -F _journalctl jc
complete -F _systemctl  sc

### env ###
export LS_COLORS='bd=48;5;230;38;5;244;01:ca=30;41:cd=48;5;230;38;5;244;01:di=01;38;5;33:ex=01;38;5;10:pi=48;5;230;38;5;136;01:ln=01;38;5;37:mh=38;5;9:or=48;5;15;38;5;9:ow=48;5;235;38;5;33:sg=48;5;136;38;5;230:su=48;5;160;38;5;230:so=48;5;230;38;5;136;01:st=48;5;33;38;5;230:tw=48;5;64;38;5;230:*.7z=38;5;63:*.Z=38;5;63:*.a=38;5;63:*.ace=38;5;63:*.apk=38;5;63:*.arj=38;5;63:*.bz=38;5;63:*.bz2=38;5;63:*.cpio=38;5;63:*.deb=38;5;63:*.dmg=38;5;63:*.dz=38;5;63:*.gem=38;5;63:*.gz=38;5;63:*.iso=38;5;63:*.jar=38;5;63:*.lz=38;5;63:*.lzh=38;5;63:*.lzma=38;5;63:*.lzo=38;5;63:*.rar=38;5;63:*.rpm=38;5;63:*.rz=38;5;63:*.tar=38;5;63:*.taz=38;5;63:*.tbz=38;5;63:*.tbz2=38;5;63:*.tgz=38;5;63:*.tlz=38;5;63:*.txz=38;5;63:*.tz=38;5;63:*.tzst=38;5;63:*.xz=38;5;63:*.z=38;5;63:*.zip=38;5;63:*.zoo=38;5;63:*.zpaq=38;5;63:*.zst=38;5;63:*.zstd=38;5;63:*.CR2=38;5;136:*.JPG=38;5;136:*.PNG=38;5;136:*.avif=38;5;136:*.bmp=38;5;136:*.cgm=38;5;136:*.dl=38;5;136:*.emf=38;5;136:*.eps=38;5;136:*.gif=38;5;136:*.heif=38;5;136:*.ico=38;5;136:*.jpeg=38;5;136:*.jpg=38;5;136:*.mng=38;5;136:*.pbm=38;5;136:*.pcx=38;5;136:*.pgm=38;5;136:*.png=38;5;136:*.ppm=38;5;136:*.svg=38;5;136:*.svgz=38;5;136:*.tga=38;5;136:*.tif=38;5;136:*.tiff=38;5;136:*.webp=38;5;136:*.xbm=38;5;136:*.xcf=38;5;136:*.xpm=38;5;136:*.xwd=38;5;136:*.yuv=38;5;136:*#=38;5;8:*log=38;5;8:*~=38;5;8:*.aux=38;5;8:*.bak=38;5;8:*.cache=38;5;8:*.class=38;5;8:*.elc=38;5;8:*.incomplete=38;5;8:*.o=38;5;8:*.out=38;5;8:*.part=38;5;8:*.pyc=38;5;8:*.swp=38;5;8:*.temp=38;5;8:*.tmp=38;5;8:*.aac=38;5;166:*.ac3=38;5;166:*.flac=38;5;166:*.m3u=38;5;166:*.m3u8=38;5;166:*.m4a=38;5;166:*.mid=38;5;166:*.midi=38;5;166:*.mka=38;5;166:*.mp3=38;5;166:*.oga=38;5;166:*.ogg=38;5;166:*.opus=38;5;166:*.spx=38;5;166:*.wav=38;5;166:*.xspf=38;5;166:*.ass=38;5;166:*.idx=38;5;166:*.mks=38;5;166:*.srt=38;5;166:*.ssa=38;5;166:*.sub=38;5;166:*.vtt=38;5;166:*.MOV=01;38;5;166:*.avi=01;38;5;166:*.flv=01;38;5;166:*.m2ts=01;38;5;166:*.m2v=01;38;5;166:*.m4v=01;38;5;166:*.mkv=01;38;5;166:*.mov=01;38;5;166:*.mp4=01;38;5;166:*.mp4v=01;38;5;166:*.mpeg=01;38;5;166:*.mpg=01;38;5;166:*.ogm=01;38;5;166:*.ogv=01;38;5;166:*.ogx=01;38;5;166:*.vob=01;38;5;166:*.webm=01;38;5;166:*.wmv=01;38;5;166:'

# Editor
if command -v vim >/dev/null 2>&1; then
    EDITOR="vim -c 'set ignorecase'"
elif command -v vi >/dev/null 2>&1; then
    EDITOR=vi
fi
if [[ -n $EDITOR ]]; then
    export EDITOR
    export VISUAL=$EDITOR
    alias v="$EDITOR"
fi


### functions ###
bak () {
    local ts=$(date +%Y-%m-%dT%H%M%S%z)
    local user=${USER:-$(id -un)}

    # ${@%/} removes trailing slashes to avoid creating subdirectories like `/SRC/-DATE.bak`
    for arg in "${@%/}"; do
        cp -a -- "${arg}" "${arg}-${user}-${ts}.bak"
    done
}

cd () {
    builtin cd "$@" && ls
}

con-by-state () {
    ss -nat | tail -n +2 | awk '{print $1}'| sort | uniq -c | sort -rn
}

con-by-ip () {
    ss -ntu | tail -n +2 | awk '{print $6}' | cut -d: -f1 | sort | uniq -c | sort -n
}

f () {
    to_search=$(echo $* | sed "s/ /*/g")
    find . -iname "*${to_search}*"
}

getip () {
    dig +short myip.opendns.com @resolver1.opendns.com
}

get-limits-proc () {
    echo 'Max System Threads (Kernel Limit):'
    cat /proc/sys/kernel/threads-max

    echo
    echo 'Max Threads Of PID 1 (And Children):'
    grep --color=never 'Max processes' /proc/1/limits

    echo
    echo 'Current Thread Parent Tree Limits:'
    pid=$$
    while (( pid > 1 )); do
        printf '%-7s %-15s %s\n' $pid "$(cat /proc/$pid/comm)" \
               "$(awk '/Max processes/ {print $3, $4}' /proc/$pid/limits)"
        pid=$(ps -o ppid= -p $pid | tr -d ' ')
    done

    echo
    echo 'PAM Limits:'
    # PAM limits (applied by sudo/sshd/login if pam_limits is enabled)
    grep --color=never -rn nproc /etc/security/limits.conf /etc/security/limits.d/ 2>/dev/null
    grep --color=never -rn pam_limits /etc/pam.d/ 2>/dev/null

    echo
    echo 'Systemd Default Threads Limits:'
    # Systemd defaults and unit overrides
    grep --color=never -rn NPROC /etc/systemd/system.conf /etc/systemd/system.conf.d/ /etc/systemd/user.conf 2>/dev/null
    systemctl show -p DefaultLimitNPROC
    echo
    echo 'Systemd sshd Threads Limit:'
    systemctl show sshd -p LimitNPROC
}

mkcd () {
  (( $# == 1 )) || return 1
  mkdir -p "$1" && builtin cd "$1"
}

motd () {
    [[ -f /etc/motd ]] && cat /etc/motd && echo

    uname -a

    echo
    _onlinux && free -m
    _onmac   && top -l 1 | \grep PhysMem

    echo; w
}

slit () {
    # print columns 1 2 3 ... n
    awk "{ print ${(j:,:):-\$${^@}}  }"
}

diff-fw () {
    if grep -i centos /etc/issue || [ -f /etc/redhat-release ]; then
        diff <(iptables-save) /etc/sysconfig/iptables
    else
        diff <(iptables-save) /etc/network/iptables-rules
    fi
}

vdiff-fw () {
    if grep -i centos /etc/issue || [ -f /etc/redhat-release ]; then
        vimdiff <(iptables-save) /etc/sysconfig/iptables
    else
        vimdiff <(iptables-save) /etc/network/iptables-rules
    fi
}

### prompt ###
[[ -z ${_HOST} ]] && _HOST=$(hostname)
_is_host_prod=false
[[ ${_HOST} == *.prd* || ${_HOST} == *.prod* || ${_HOST} == *.production* ]] && _is_host_prod=true

# Since Bash only knows the cursor position by counting the number of characters *printed*, we need
# to "escape" terminal control sequences with `\[` and `\]` (man -P "$PAGER -p '^PROMPTING'" bash)
_term_bold="\[$(tput bold)\]"
_term_reset="\[$(tput sgr0)\]"
_term_red="\[$(tput setaf 1)\]"
_term_green="\[$(tput setaf 2)\]"
_term_blue="\[$(tput setaf 4)\]"
_term_standout="\[$(tput smso)\]"

# _HOST can be set by the caller (e.g. `s()`)
_prompt_host="${_term_green}${_HOST}${_term_reset}"

_prompt_symbol="${_term_blue}"
[[ $_is_host_prod == true ]] && _prompt_symbol+="🔥 "
(( "${EUID}" == 0 )) && _prompt_symbol+="⚡️" || _prompt_symbol+="$"
_prompt_symbol+="${_term_reset}"

_prompt_command() {
    local exit_code=$?
    (( ${exit_code} != 0 )) && local _prompt_error_code="${_term_red}${exit_code}${_term_reset} "

    local tilde='~' # Avoid Bash 3.* vs 5.* different tilde expansion behavior
    local cwd="${PWD/#$HOME/$tilde}"
    local _prompt_dir="${_term_standout}${_term_blue} ${cwd} ${_term_reset}"
    local _prompt_time="${_term_green}$(date +%H:%M:%S)${_term_reset}"

    # Set terminal title
    local _term_title="\e]2;"
    if [[ -z $TMUX ]]; then # See TMUX comment above
      _term_title+="${_HOST} "
    fi
    _term_title+="${cwd}\a"

    PS1="${_term_title}${_prompt_time} ${_prompt_error_code}${_prompt_host} ${_prompt_dir}\n${_prompt_symbol} "
}
PROMPT_COMMAND=_prompt_command

### init ###
motd
