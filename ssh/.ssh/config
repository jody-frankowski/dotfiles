# Include specific configs.
# As they are declared first, they will take priority over the rest of this file.
Include config-*

# Auto-`ssh-add` keys specified with `IdentityFile` to the agent
AddKeysToAgent yes

# Share existing connections to reduce lag when logging into the same
# Host in a second shell
ControlMaster auto
ControlPath ~/.cache/ssh/%h_%p_%r
ControlPersist 12h

# Only offer private keys from the agent that are explicitly listed in the config.
# This prevents servers to learn about public keys that we don't want them to know.
# Check that this works with `ssh whoami.filippo.io -o ControlPath=none`: If no keys are listed, you're good.
IdentitiesOnly yes
# This is also required, otherwise, the default (id_rsa, id_ed25519...) is used as a fallback and
# could be used to identify you. It can still be overriden in `Host ...` configs.
IdentityFile none

# Sort by commonness. This also disables gssapi-with-mic (Kerberos & co) and hostbased (reverse
# authentication).
PreferredAuthentications publickey,keyboard-interactive,password

# Drop unresponsive connections after 10 `Server Alive` messages without reply
ServerAliveCountMax 10
# Request a `Server Alive` from the server every 60 seconds
ServerAliveInterval 60

# Automatically trust new host keys, but not the ones that have changed (TOFU)
StrictHostKeyChecking accept-new

# Magic hop https://wiki.gentoo.org/wiki/SSH_jump_host
Host *+*
    ProxyCommand ssh $(echo %h | sed 's/+[^+]*$//;s/\([^+%%]*\)%%\([^+]*\)$/\2 -l \1/;s/:/ -p /') exec nc -w1 $(echo %h | sed 's/^.*+//;/:/!s/$/ %p/;s/:/ /')

# Example on how to disable a server motd by forcing a specific shell.
# Matching on empty commands filters out cli-specified command or commands like rsync that use a
# specific remote command. It avoids the following error: Cannot execute command-line and remote
# command.
# Match command "" Host *.example.com
#   # Suppress pam_motd.so
#   RemoteCommand bash -li
#   RequestTTY yes
#   # Suppress /etc/issue
#   LogLevel ERROR

# Default config. Override above where necessary.
# `final` applies this at the last config parsing pass, but it still needs to be after any other
# `Match`.
Match final all
    # https://eieio.games/blog/ssh-sends-100-packets-per-keystroke/
    # https://news.ycombinator.com/item?id=46723990
    # I'm not sure the benefits are worth it
    ObscureKeystrokeTiming no

    # Use root by default to prevent leaking our username by mistake
    User root
